/*
version now: 2
从旧版本更新? 请看 Release 中的更改说明
*/
{
    "version": 2, // 配置版本号，一般无需更改 (其实没用, 用来给自己看配置版本的)
    "debug": false, // Flask 服务器的 debug 开关
    "host": "127.0.0.1", // 监听地址, 0.0.0.0 表示所有; 注意: 如果还需要监听 ipv6 请求，请设置为 ::
    "port": 9010, // 监听端口, 默认 9010
    "secret": "MySecret", // 密钥, 更新状态时使用
    "status": 0, // 目前的状态 (整数)
    "app_name": "系统桌面", //当前使用的软件名称
    "pc_status": 0, // 电脑端状态 (整数, 对应 status_list 索引)
    "pc_app_name": "系统桌面", // 电脑端当前使用的软件名称
    "pc_slack_apps": ["Bilibili", "哔哩哔哩", "YouTube", "抖音", "TikTok", "微博", "小红书", "知乎", "Netflix", "爱奇艺", "腾讯视频", "优酷", "Steam", "Epic Games", "Minecraft", "网易云音乐", "Spotify", "QQ音乐", "游戏"], // 判定为“摸鱼”的前台应用（精确匹配，不区分大小写）
    "pc_work_apps": ["Xcode", "Visual Studio Code", "Code", "终端", "Terminal", "iTerm2", "IntelliJ IDEA", "PyCharm", "WebStorm", "GoLand", "Sublime Text", "Nova", "Pages", "Numbers", "Keynote", "Microsoft Word", "Word", "Microsoft Excel", "Excel", "Microsoft PowerPoint", "PowerPoint", "飞书", "钉钉", "Slack", "Notion", "Obsidian", "Figma", "Sketch", "Docker", "Postman"], // 判定为“认真工作”的前台应用
    "status_list": [ // 状态列表, 索引从 0 开始, 对应上面的 status
        { // status: 0
            "id": 0, // 与索引相同，非必须，仅为方便查看 (建议加上)
            "name": "APP", // 状态名称
            "desc": "目前手机使用的应用，大概率在玩手机摸鱼。", // 状态描述
            "color": "awake" // 状态颜色, 对应 templates/style.css 中的 .sleeping .awake 等类, 可自行前往修改
        },
        { // status: 1
            "id": 1,
            "name": "似了",
            "desc": "睡似了或其他原因不在线，紧急情况请使用电话联系。",
            "color": "sleeping"
        }
        // 还可添加更多，以此类推
    ],
    "other": { // 其他配置 (网页上的信息)
        "user": "miku", // 你的名字
        "background": "https://s.040905.xyz/d/v/1686810550994.jpg?sign=vxvbNJbxPZ-thzF6Pf7QKy4jp0p9lKb3YVGGlLRhQms=:0", // 背景图片 url, 可用网络上的图片 api; 推荐 repo: wyf01239/imgapi (网络 api 集合)
        "alpha": 0.85, // 卡片不透明度设置 (0 ~ 1), 0 为完全透明, 1 为完全不透明
        "learn_more": "GitHub Repo", // 更多信息链接的提示, 默认为 github repo
        "repo": "https://github.com/HBWuChang/sleepy", // 更多信息链接的目标, 可填存储库链接
        "more_text": "", // 内容将在状态信息和 "你可以通过这个页面知晓..." 中间插入 (不转义); ps: 可以在这里放你联系方式的链接
        "privacy_note": "本页使用浏览器指纹做访问统计，不收集姓名等身份信息。" // 会显示在卡片底部；留空则不显示
    }
}